{
  "name": "launchset",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:shadow": "opennextjs-cloudflare build --config wrangler.shadow.jsonc && opennextjs-cloudflare deploy --config wrangler.shadow.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "bing": "node scripts/bing-cli.mjs",
    "google": "node scripts/google-cli.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "better-auth": "^1.6.25",
    "next": "^16.2.11",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "typescript": "^5",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  }
}
