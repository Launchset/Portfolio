{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "launchset-shadow",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "launchset-auth-shadow",
      "database_id": "41dd0af2-d4b3-4a14-ac63-d0749dd0101c",
      "migrations_dir": "migrations/auth"
    },
    {
      "binding": "APP_DB",
      "database_name": "launchset-app-shadow",
      "database_id": "9c4f8773-371a-45c3-b919-dc11d7e29005",
      "migrations_dir": "migrations/app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTRACTS",
      "bucket_name": "launchset-contracts-shadow"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL"
    }
  ],
  "vars": {
    "AUTH_ADMIN_EMAIL": "launchsetfreelancer@gmail.com",
    "AUTH_EMAIL_FROM": "Launchset <login@launchset.dev>",
    "BETTER_AUTH_URL": "https://launchset-shadow.jhelyar04.workers.dev",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1U0d66IdJKqNiD7V3ofgdkfs"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
